# Keep real values only in .env, which is ignored by Git.

# Frontend: URL of the deployed backend API (Render web service).
# Leave unset for local development — Vite proxies /api to http://localhost:5174.
VITE_API_URL=

# Backend (set these on Render, not here):
# Optional Solscan Pro API key for token metadata and holder enrichment.
SOLSCAN_API_KEY=
# Optional AI explanation key, plus its OpenAI-compatible URL and model.
CHAT_B_AI_API_KEY=
CHAT_B_AI_API_URL=
CHAT_B_AI_MODEL=
# Optional: restrict cross-origin API access to your frontend, e.g. https://your-site.onrender.com
CORS_ORIGIN=
